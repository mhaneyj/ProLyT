# Leave DATABASE_URL blank to run in demo mode (sample data, in-memory database).

# ── Neon Postgres ──
# Neon console → Connect → choose the POOLED connection string (host contains "-pooler")
DATABASE_URL=

# ── Sign-in email (Resend) ──
# resend.com → API Keys. Verify your sending domain (e.g. prolyt.com) first.
RESEND_API_KEY=
EMAIL_FROM=ProLyt <signin@prolyt.com>
# Emails that become ProLyt admins the first time they sign in (comma-separated)
PLATFORM_ADMIN_EMAILS=

# ── Stripe Connect ──
STRIPE_SECRET_KEY=
# From the webhook endpoint you add for https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── App ──
NEXT_PUBLIC_SITE_URL=https://prolyt.com
# Program web addresses: <slug>.prolyt.com
NEXT_PUBLIC_ROOT_DOMAIN=prolyt.com
# Optional: show one program everywhere (handy on a *.vercel.app address before you own a domain)
NEXT_PUBLIC_ORG_SLUG=
# Any long random string; Vercel Cron sends it to the weekly payout job
CRON_SECRET=
