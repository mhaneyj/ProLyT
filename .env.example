# Leave everything blank to run in demo mode (sample data, in-memory database).

# ── Supabase (database + sign-in) ──
# Project Settings → Database → Connection string (use the "Transaction pooler" URI on Vercel)
DATABASE_URL=
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe Connect ──
STRIPE_SECRET_KEY=
# From the webhook endpoint you add for https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── App ──
NEXT_PUBLIC_SITE_URL=https://portal.example.com
NEXT_PUBLIC_ORG_SLUG=gamefit-loomis
# Any long random string; Vercel Cron sends it to the weekly payout job
CRON_SECRET=
